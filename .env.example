# Prava sandbox values. Keep PRAVA_SECRET_KEY server-side only.
PRAVA_BACKEND_URL=https://sandbox.api.prava.space
# Required for hosted checkout/passkey testing. Use an HTTPS tunnel URL,
# e.g. https://example.ngrok-free.app/prava/callback
PRAVA_CALLBACK_URL=
PRAVA_PUBLISHABLE_KEY=
PRAVA_SECRET_KEY=
# PRAVA_API_KEY is also accepted as a legacy alias for PRAVA_SECRET_KEY.
OPENAI_API_KEY=
PRAVA_MANDATE_MAX_USD=75
# Flight data providers (self-serve signup, free tiers):
DUFFEL_API_TOKEN=            # Duffel flight search & booking — https://duffel.com/docs
FLIGHTAWARE_AEROAPI_KEY=     # FlightAware AeroAPI real-time flight status — https://www.flightaware.com/aeroapi/
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Optional Comms delivery (without these, WhatsApp/SMS stay preview-only):
TWILIO_WHATSAPP_FROM=            # e.g. whatsapp:+14155238886 (Twilio sandbox number)
TWILIO_PHONE_NUMBER=             # e.g. +15551234567 (SMS fallback sender)
MEMBER_WHATSAPP_NUMBER=          # e.g. whatsapp:+15551234567
MEMBER_PHONE_NUMBER=             # e.g. +15551234567
# Public HTTPS base URL for approve/decline buttons (e.g. https://you.ngrok-free.app).
# Falls back to the PRAVA_CALLBACK_URL origin when unset.
PUBLIC_BASE_URL=
