# Prava sandbox values. Keep PRAVA_SECRET_KEY server-side only.
PRAVA_BACKEND_URL=https://sandbox.api.prava.space
# Required for hosted checkout/passkey testing. Use an HTTPS tunnel URL,
# e.g. https://example.ngrok-free.app/prava/callback
PRAVA_CALLBACK_URL=
PRAVA_PUBLISHABLE_KEY=
PRAVA_SECRET_KEY=
# PRAVA_API_KEY is also accepted as a legacy alias for PRAVA_SECRET_KEY.
PRAVA_MANDATE_MAX_USD=75
AMADEUS_API_KEY=
AMADEUS_API_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
